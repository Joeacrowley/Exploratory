#| collapse: true
library(tidyverse)
library(haven)
library(labelled)
devtools::load_all("..")
# Reuse the same synthetic dataset the Exploratory book uses.
df <- readRDS(file.path("..", "..", "data", "synthetic_bsa2019.rds"))
df |> count_across(vars = c("skipmeal", "Politics", "Poverty1"))
ctab(df, skipmeal, RSex)
tbl <- df |> ctabs(vars = c("HEdQual3"), preds = c("RClassGp", "RAgeCat"))
tbl[[1]][[1]]
#| eval: false
ctabs_xlsx(tbl, filename = "ctabs_export.xlsx")
getwd()
df |> select(Married, ChildHh) |> mfreq(labels = TRUE)
df |> df_miss() |> arrange(desc(p_miss)) |> head()
df |> df_miss_brk(brk = "RAgeCat", show = "perc_miss") |> df_miss_brk_h(print = "f")
df |> num_sum(vars = c("libauth", "leftrigh", "welfare2"))
num_crs(df, nums = c("libauth", "leftrigh", "welfare2"), brk = "RAgeCat", stats = "mean")
natural_breaks(df, vars = c("libauth", "leftrigh", "welfare2"), nbrk = 5)
return_one2(df, out = "skipmeal", lev = c("n_val", "p_val"), preds = c("RSex", "RAgeCat")) |>
return_one2_format(print = "f")
help(return_one2_format)
install.packages("roxygen2")
getwd()
setwd("/Users/joecrowley/5 - R/Exploratory/Quick_descriptives")
devtools::document("/Users/joecrowley/5 - R/Exploratory/Quick_descriptives")
devtools::load_all("..")
?return_one2_format
devtools::check()
?count_across
df |> count_across(vars = c("skipmeal", "Politics", "Poverty1"))
df |> count_across(vars = c("skipmeal", "Politics", "Poverty1")) %>% print(n=100)
df |> count_across(vars = c("skipmeal", "Politics", "Poverty1"), labels = f) %>% print(n=100)
df |> count_across(vars = c("skipmeal", "Politics", "Poverty1"), labels = F) %>% print(n=100)
devtools::document("/Users/joecrowley/5 - R/Exploratory/Quick_descriptives")
devtools::check()
devtools::load_all("..")
getwd()
devtools::load_all("..")
devtools::load_all("/Users/joecrowley/5 - R/Exploratory/Quick_descriptives")
return_one2()
