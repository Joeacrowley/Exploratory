# "ess_uk",
# "ess10_snippet",
"bsa2019_sav"
)
#| label: synthesise
out_dir <- path.expand("~/R/Data/synthetic data")
clamp_to_original <- function(df_synth, df_real, overrides = list()) {
for (var in names(df_synth)) {
if (is.numeric(df_real[[var]])) {
lo <- if (var %in% names(overrides)) overrides[[var]][1] else min(df_real[[var]], na.rm = TRUE)
hi <- if (var %in% names(overrides)) overrides[[var]][2] else max(df_real[[var]], na.rm = TRUE)
df_synth[[var]] <- pmax(pmin(df_synth[[var]], hi), lo)
}
}
df_synth
}
synthesise_one <- function(name, cfg) {
message("\n=== Synthesising: ", name, " ===")
# Load
if (is.null(cfg$path)) {
df_real <- get(name)
if (!is.data.frame(df_real)) df_real <- as.data.frame(df_real)
} else {
df_real <- cfg$read_fn(path.expand(cfg$path))
}
# Subset variables
if (!is.null(cfg$vars)) {
df_real <- df_real |> select(all_of(cfg$vars))
}
# Convert any remaining labelled vectors to factors
df_real <- labelled::unlabelled(df_real)
# Synthesis parameters
k <- if (nrow(df_real) > 50000) round(nrow(df_real) * 0.5) else nrow(df_real)
methods_vec <- sapply(df_real, function(x) {
if (is.character(x) || (is.factor(x) && nlevels(x) > 15)) "sample" else "cart"
})
start <- Sys.time()
synth_obj <- syn(df_real, seed = 42, k = k, method = methods_vec)
end <- Sys.time()
message("Time: ", round(difftime(end, start, units = "mins"), 1), " mins | k = ", k)
# Clamp numeric ranges
df_synth <- clamp_to_original(synth_obj$syn, df_real)
# Apply dataset-specific post-processing if defined.
# post_fn may optionally accept df_real as a second argument (e.g. to copy
# labelled structure back onto the synthetic data before saving as .sav)
if (!is.null(cfg$post_fn)) {
if (length(formals(cfg$post_fn)) >= 2) {
df_synth <- cfg$post_fn(df_synth, df_real)
} else {
df_synth <- cfg$post_fn(df_synth)
}
}
# Copy variable labels from real data (skipped for sav format — post_fn handles it)
if (is.null(cfg$save_format) || cfg$save_format != "sav") {
shared_vars <- intersect(names(df_synth), names(df_real))
labelled::var_label(df_synth[shared_vars]) <- labelled::var_label(df_real[shared_vars])
}
# Save in specified format (default rds)
save_format <- if (!is.null(cfg$save_format)) cfg$save_format else "rds"
if (save_format == "sav") {
out_path <- file.path(out_dir, paste0("synthetic_", name, ".sav"))
haven::write_sav(df_synth, out_path)
message("Saved: ", nrow(df_synth), " rows, ", ncol(df_synth), " cols → ",
"synthetic_", name, ".sav")
} else {
saveRDS(df_synth, file.path(out_dir, paste0("synthetic_", name, ".rds")))
message("Saved: ", nrow(df_synth), " rows, ", ncol(df_synth), " cols → ",
"synthetic_", name, ".rds")
}
invisible(df_synth)
}
# Run selected datasets
results <- lapply(run, function(nm) synthesise_one(nm, datasets[[nm]]))
names(results) <- run
