path    = NULL,
vars    = NULL,
read_fn = NULL
),
bsa_2017 = list(
path    = "~/R/Data/BSA Teaching Data/spss/spss24/bsa2017_for_ukda.sav",
vars    = c("dolefidl", "leftrigh", "leftrig2", "RAgecat5", "hadvice", "Rsex"),
read_fn = function(p) read_sav(p) |> labelled::unlabelled() |> as.data.frame()
),
bsa_clean = list(
path    = "~/R/Data/BSA Teaching Data/spss/spss25/Clean BSA dataframe.Rds",
vars    = NULL,
read_fn = function(p) { e <- new.env(); load(p, envir = e); as.data.frame(get(ls(e)[1], envir = e)) }
),
bsa2019 = list(
path    = "~/R/Data/BSA Teaching Data/spss/spss25/bsa2019_poverty_open.sav",
vars    = NULL,
read_fn = function(p) read_sav(p) |> labelled::unlabelled() |> as.data.frame()
),
bsa2019_sav = list(
path        = "~/R/Data/BSA Teaching Data/spss/spss25/bsa2019_poverty_open.sav",
vars        = NULL,
save_format = "sav",
# Load with user_na = TRUE to preserve user missing value metadata,
# then convert user NAs to regular NAs so synthpop treats them as missing
read_fn     = function(p) read_sav(p, user_na = TRUE) |> labelled::user_na_to_na() |> as.data.frame(),
# After synthesis: copy labelled structure from real data back onto synthetic,
# then flag any negative values as user missing (value = -1)
post_fn     = function(df_synth, df_real) {
# Copy full labelled structure (value labels, variable labels, na_values) from real data
for (v in intersect(names(df_synth), names(df_real))) {
if (haven::is.labelled(df_real[[v]])) {
df_synth[[v]] <- haven::labelled(
df_synth[[v]],
labels    = attr(df_real[[v]], "labels"),
label     = attr(df_real[[v]], "label"),
na_values = attr(df_real[[v]], "na_values")
)
}
}
# Set any negative synthetic values as user missing (na_value = -1)
for (v in names(df_synth)) {
if (is.numeric(df_synth[[v]]) || haven::is.labelled(df_synth[[v]])) {
has_neg <- !is.na(df_synth[[v]]) & df_synth[[v]] < 0
if (any(has_neg)) {
df_synth[[v]] <- labelled::set_na_values(df_synth[[v]], -1)
df_synth[[v]][has_neg] <- -1
}
}
}
df_synth
}
),
ess_uk = list(
path    = "~/R/Data/ESS_UK/ESS_UK_R_data_file.RData",
vars    = c("pray", "accdng", "accalaw", "acchome", "accwrk", "accmove", "accoth", "accnone", "accref", "accdk", "accna", "gndr", "ageyo30", "age", "anweight"),
read_fn = function(p) { e <- new.env(); load(p, envir = e); as.data.frame(get(ls(e)[1], envir = e)) },
post_fn = function(df) {
acc_vars <- names(df)[grepl("^acc", names(df))]
combined_na_mask <- rowSums(is.na(df[acc_vars])) > 0
for (v in acc_vars) df[[v]][combined_na_mask] <- NA
df
}
),
ess10_snippet = list(
path    = "~/R/gtsummary_tables/ESS_UK_snippet_Round 10.RData",
vars    = NULL,
read_fn = function(p) { e <- new.env(); load(p, envir = e); as.data.frame(get(ls(e)[1], envir = e)) }
)
